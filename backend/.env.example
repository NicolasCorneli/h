# DESENVOLVIMENTO LOCAL: copie para backend/.env e preencha. O .env NÃO vai para o Git.
# Para produção, a referência é o .env.example da raiz (docker-compose.yml da raiz) e o
# DEPLOY.md. Com AMBIENTE=producao a API exige DATABASE_URL própria, URL_PUBLICA com
# https e MODO_DEMO=false, e se recusa a subir sem eles.

# --- Banco de dados -------------------------------------------------------
DATABASE_URL=postgresql+psycopg://espelho:espelho@localhost:5432/espelho

# --- Segurança ------------------------------------------------------------
# Obrigatório. Gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_MINUTOS_ACCESS=30
JWT_DIAS_REFRESH=30

# --- Entrar com Google (opcional) ------------------------------------------
# IDs de cliente OAuth 2.0 criados no Google Cloud (web, Android, iOS), separados por
# vírgula. Não são segredos, mas são deste projeto: crie os seus (ver
# docs/GUIA_LOGIN_GOOGLE.md). Vazio = login com Google desligado e botão escondido.
# O servidor NÃO precisa de "client secret": ele só confere o token do Google.
GOOGLE_CLIENT_IDS=

# Fuso do salão: define em que dia caiu um atendimento concluído perto da meia-noite.
FUSO_HORARIO=America/Sao_Paulo

# Endereço público da API (https://api.exemplo.com). Vazio no desenvolvimento: as URLs das
# imagens usam o endereço da própria requisição (o celular chega pelo IP da rede local).
URL_PUBLICA=

# Logs: texto (terminal) ou json (coletores de log); nível INFO, WARNING...
LOG_FORMATO=texto
LOG_NIVEL=INFO

# Origens autorizadas no CORS, separadas por vírgula.
# Em desenvolvimento, o Expo web usa http://localhost:8081.
CORS_ORIGENS=http://localhost:8081,http://localhost:19006

# --- Storage de imagens ---------------------------------------------------
# local = disco (padrão em desenvolvimento) | s3 = S3, MinIO ou Supabase Storage
STORAGE_DRIVER=local
# Caminho relativo é sempre a partir da pasta backend, de onde quer que a API seja iniciada.
STORAGE_DIR=./dados/imagens

# Usados apenas quando STORAGE_DRIVER=s3
STORAGE_URL=
STORAGE_BUCKET=espelho
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_REGIAO=us-east-1

# --- Provedor de IA -------------------------------------------------------
# fake = gera o resultado localmente, sem custo e sem credencial (desenvolvimento).
#        Não é IA: a imagem sai recolorida e com aviso, e o corte não muda.
# replicate = chamadas reais à Replicate (pagas)
AI_PROVIDER=fake
# Token da Replicate (https://replicate.com/account/api-tokens). Só no servidor; sem
# aspas e sem espaços. Nunca coloque no aplicativo nem no controle de versão.
AI_API_KEY=

# Os dois modelos da etapa "Estilo e cor" (formato dono/nome). O aplicativo nunca
# escolhe o modelo: o servidor escolhe conforme o pedido.
#   principal: pedidos que batem com os exemplos da tela (opções haircut / hair_color)
AI_MODELO=flux-kontext-apps/change-haircut
#   descrição livre de corte e cor (prompt + input_image). Vazio = só os exemplos.
AI_MODELO_TEXTO=black-forest-labs/flux-kontext-pro

# Tempo limite de cada geração. 120 dá folga para filas do provedor.
AI_TIMEOUT_S=120
# Como a descrição em português vai nos prompts: pt_com_termos (padrão: o texto como foi
# escrito, mais os termos técnicos em inglês) ou pt (só o texto).
AI_INSTRUCAO_IDIOMA=pt_com_termos
# Fotos até este tamanho vão como data URI; acima, pela API de arquivos da Replicate
# (e são apagados de lá depois do uso).
AI_LIMITE_DATA_URI_KB=1024
# Lado maior das imagens enviadas ao modelo, em pixels.
AI_LADO_MAXIMO_ENVIO=1536
# Por quanto tempo o schema publicado de cada modelo é reaproveitado (minutos).
AI_CACHE_ESQUEMA_MIN=60

# Endereço do provedor. Em desenvolvimento e produção, deixe o padrão. Os testes
# apontam esta variável para um servidor de mentira para exercitar o cliente real
# sem chamar o serviço externo e sem custo.
AI_BASE_URL=https://api.replicate.com/v1
# Intervalo entre consultas ao estado da predição.
AI_INTERVALO_CONSULTA_S=1

# Teto de simulações por conta a cada hora. Cada geração custa dinheiro no
# provedor: sem um teto, uma conta (ou um token roubado) esvazia o crédito.
SIMULACAO_MAX_POR_HORA=3

# --- Validação de imagem --------------------------------------------------
IMAGEM_MAX_BYTES=8388608
IMAGEM_MIN_LADO=480
IMAGEM_MAX_LADO=4096
VALIDAR_ROSTO=true

# --- Demonstração ---------------------------------------------------------
# true habilita os atalhos de demonstração do aplicativo (forçar foto recusada
# e forçar falha do provedor). Deve ficar false em produção.
MODO_DEMO=true
AMBIENTE=desenvolvimento
