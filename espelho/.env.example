# Copie para .env e preencha. O arquivo .env NÃO vai para o repositório.
# Variáveis EXPO_PUBLIC_* entram no pacote do aplicativo: nunca coloque segredos aqui.

# Endereço da API (ex.: https://api.seusalao.com.br).
# Desenvolvimento: vazio = descobre sozinho (mesmo computador ou o IP do Expo na rede).
# Build de produção para celular: OBRIGATÓRIO (sem ele o app avisa que não tem servidor).
# Build de produção para a web: vazio = a API no mesmo domínio do site (proxy em /api).
EXPO_PUBLIC_API_URL=

# --- Entrar com Google (opcional) ------------------------------------------
# IDs de cliente OAuth do Google Cloud. Os mesmos precisam estar em GOOGLE_CLIENT_IDS no
# servidor. Sem eles o botão "Entrar com Google" não aparece. Ver docs/GUIA_LOGIN_GOOGLE.md.
# Navegador (expo start --web):
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Build de desenvolvimento ou de produção (não funciona no Expo Go):
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
