# Salão em Dia: variáveis da implantação (docker-compose.yml da raiz).
#
#   cp .env.example .env      # na raiz do projeto, no servidor
#   chmod 600 .env            # o arquivo guarda segredos: só o dono lê
#   docker compose up -d --build --wait
#
# Nenhum valor aqui é real. O .env não vai para o Git (.gitignore). Para o
# desenvolvimento local, use backend/.env.example e espelho/.env.example.
# Passo a passo completo em DEPLOY.md.

# ==========================================================================
# OBRIGATÓRIAS: sem elas o docker compose recusa subir
# ==========================================================================

# Domínio onde o sistema vai responder, sem https:// e sem barra. O DNS dele precisa
# apontar para este servidor ANTES de subir: o Caddy pede o certificado HTTPS ao Let's
# Encrypt na primeira subida. O site fica em https://DOMINIO e a API em
# https://DOMINIO/api. Para testar na própria máquina, use: localhost
DOMINIO=

# Senha do PostgreSQL (o banco só é alcançável pela rede interna do compose).
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Assina os tokens de sessão e as URLs das imagens. 32+ caracteres, aleatório, e
# diferente em cada ambiente. Trocá-lo desconecta todo mundo (todas as sessões caem).
# Gere com: openssl rand -hex 32
JWT_SECRET=

# ==========================================================================
# Provedor de IA (simulação capilar)
# ==========================================================================

# fake = gera localmente, sem custo e SEM IA (a imagem sai recolorida e com aviso).
# replicate = chamadas reais e pagas à Replicate.
AI_PROVIDER=fake
# Token da Replicate (começa com r8_). Só no servidor; nunca no aplicativo.
AI_API_KEY=
AI_MODELO=flux-kontext-apps/change-haircut
# Descrição livre de corte e cor. Vazio desliga (só os exemplos da tela).
AI_MODELO_TEXTO=black-forest-labs/flux-kontext-pro
AI_INSTRUCAO_IDIOMA=pt_com_termos
# Tempo limite de cada geração, em segundos.
AI_TIMEOUT_S=120
# Teto de simulações por conta a cada hora: limita o gasto se uma conta (ou um
# token roubado) gerar em laço.
SIMULACAO_MAX_POR_HORA=3

# ==========================================================================
# Armazenamento das imagens
# ==========================================================================

# local = volume Docker `dados_imagens` (entra no backup: scripts/backup_producao.sh)
# s3    = AWS S3, MinIO ou Supabase Storage (o bucket precisa ser PRIVADO)
STORAGE_DRIVER=local
STORAGE_URL=
STORAGE_BUCKET=espelho
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_REGIAO=us-east-1

# ==========================================================================
# Entrar com Google (opcional)
# ==========================================================================

# IDs de cliente OAuth (web, Android, iOS) separados por vírgula. Vazio = desligado.
GOOGLE_CLIENT_IDS=
# O ID de cliente web também entra no build do site (botão "Entrar com Google").
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ==========================================================================
# Operação (os padrões servem para começar)
# ==========================================================================

# Portas publicadas no servidor. O padrão (80 e 443) é o recomendado: o Let's Encrypt
# valida pela 80 (ou pela 443).
PORTA_HTTP=80
PORTA_HTTPS=443
# Só se a 443 estiver ocupada e o site for ficar numa porta alternativa (ex.: 9443):
# use o MESMO número em PORTA_HTTPS e aqui, mantenha PORTA_HTTP=80 livre (para o
# certificado) e defina URL_PUBLICA e CORS_ORIGENS com a porta
# (https://DOMINIO:9443). O site passa a ser acessado sempre com a porta no endereço.
# PORTA_HTTPS_INTERNA=9443
# Processos da API. Com mais de 1, o freio de tentativas de login (em memória) passa a
# valer por processo.
WEB_CONCURRENCY=1
# json (uma linha por evento, para coletores) ou texto.
LOG_FORMATO=json
LOG_NIVEL=INFO
# Fuso do salão: em que dia caiu um atendimento concluído perto da meia-noite.
FUSO_HORARIO=America/Sao_Paulo
# Validade dos tokens: acesso (minutos) e renovação (dias).
JWT_MINUTOS_ACCESS=30
JWT_DIAS_REFRESH=30
# Conexões com o banco por processo.
BANCO_POOL=5
BANCO_POOL_EXCEDENTE=10
# Etiqueta das imagens Docker construídas (use a versão ou a data, para poder voltar).
VERSAO=local

# Só se a API e o site ficarem em domínios diferentes (não é o caso do compose padrão):
# URL_PUBLICA=https://api.seusalao.com.br
# CORS_ORIGENS=https://app.seusalao.com.br

# ==========================================================================
# Aplicativo de celular (build das lojas, fora do Docker)
# ==========================================================================
# EXPO_PUBLIC_API_URL=https://DOMINIO  (o mesmo domínio acima) entra no build do EAS.
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
